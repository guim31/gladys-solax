{
  "manifest_version": 1,
  "type": "device",
  "name": "SolaX Power",
  "description": {
    "en": "SolaX inverters over the local Wi-Fi dongle: solar production, grid, battery, energy counters.",
    "fr": "Onduleurs SolaX par la clé Wi-Fi en local : production solaire, réseau, batterie, compteurs.",
    "de": "SolaX-Wechselrichter über den lokalen WLAN-Dongle: Solarproduktion, Netz, Batterie, Zähler.",
    "es": "Inversores SolaX mediante el dongle Wi-Fi local: producción solar, red, batería, contadores."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/guim31/gladys-solax:1.0.1",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-solax/main/cover.png",
  "categories": ["energy"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Local connection",
        "fr": "Connexion locale",
        "de": "Lokale Verbindung",
        "es": "Conexión local"
      },
      "description": {
        "en": "Gladys reads the inverter through its SolaX Wi-Fi or LAN dongle (Pocket WiFi), on the local network. Give the dongle a fixed IP address in your router. Read only: nothing is ever changed on the inverter.",
        "fr": "Gladys lit l'onduleur par sa clé Wi-Fi ou LAN SolaX (Pocket WiFi), sur le réseau local. Donnez à la clé une adresse IP fixe dans votre box. Lecture seule : rien n'est jamais modifié sur l'onduleur.",
        "de": "Gladys liest den Wechselrichter über seinen SolaX-WLAN- oder LAN-Dongle (Pocket WiFi) im lokalen Netzwerk. Gib dem Dongle in deinem Router eine feste IP-Adresse. Nur lesend: Am Wechselrichter wird nie etwas geändert.",
        "es": "Gladys lee el inversor a través de su dongle Wi-Fi o LAN de SolaX (Pocket WiFi), en la red local. Asigne al dongle una dirección IP fija en su router. Solo lectura: nunca se modifica nada en el inversor."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-solax/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Installationsanleitung",
            "es": "Guía de instalación"
          }
        }
      ]
    },
    {
      "key": "hosts",
      "type": "string",
      "label": {
        "en": "Dongle IP addresses",
        "fr": "Adresses IP des clés",
        "de": "IP-Adressen der Dongles",
        "es": "Direcciones IP de los dongles"
      },
      "description": {
        "en": "One address per inverter, separated by commas.",
        "fr": "Une adresse par onduleur, séparées par des virgules.",
        "de": "Eine Adresse pro Wechselrichter, durch Kommas getrennt.",
        "es": "Una dirección por inversor, separadas por comas."
      },
      "placeholder": {
        "en": "e.g. 192.0.2.10",
        "fr": "ex. 192.0.2.10",
        "de": "z. B. 192.0.2.10",
        "es": "p. ej. 192.0.2.10"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "passwords",
      "type": "secret",
      "label": {
        "en": "Dongle passwords",
        "fr": "Mots de passe des clés",
        "de": "Passwörter der Dongles",
        "es": "Contraseñas de los dongles"
      },
      "description": {
        "en": "The registration number printed on each dongle (10 characters), in the same order as the addresses. Leave empty for the old firmwares.",
        "fr": "Le numéro d'enregistrement imprimé sur chaque clé (10 caractères), dans l'ordre des adresses. Laissez vide pour les anciens firmwares.",
        "de": "Die auf jedem Dongle aufgedruckte Registriernummer (10 Zeichen), in der Reihenfolge der Adressen. Für alte Firmwares leer lassen.",
        "es": "El número de registro impreso en cada dongle (10 caracteres), en el mismo orden que las direcciones. Déjelo vacío en los firmwares antiguos."
      },
      "required": false
    },
    {
      "key": "model",
      "type": "select",
      "label": {
        "en": "Inverter model",
        "fr": "Modèle d'onduleur",
        "de": "Wechselrichtermodell",
        "es": "Modelo de inversor"
      },
      "description": {
        "en": "Detected automatically. Force it only if the readings look wrong.",
        "fr": "Détecté automatiquement. Ne le forcez que si les mesures semblent fausses.",
        "de": "Wird automatisch erkannt. Erzwinge es nur, wenn die Messwerte falsch wirken.",
        "es": "Se detecta automáticamente. Fuércelo solo si las medidas parecen incorrectas."
      },
      "required": false,
      "default": "auto",
      "options": [
        {
          "value": "auto",
