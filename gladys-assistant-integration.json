            "de": "X3-MIC PRO G2",
            "es": "X3-MIC PRO G2"
          }
        },
        {
          "value": "x1_g4",
          "label": {
            "en": "X1-Boost / Mini G4",
            "fr": "X1-Boost / Mini G4",
            "de": "X1-Boost / Mini G4",
