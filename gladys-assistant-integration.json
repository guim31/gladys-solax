  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "description": {
        "en": "Reads every inverter now and tells, for each one, the model found or what went wrong.",
        "fr": "Lit chaque onduleur maintenant et indique, pour chacun, le modèle trouvé ou ce qui ne va pas.",
        "de": "Liest jetzt jeden Wechselrichter und zeigt für jeden das gefundene Modell oder was schiefgeht.",
        "es": "Lee ahora cada inversor e indica, para cada uno, el modelo encontrado o lo que falla."
      },
      "timeout_seconds": 120
    }
  ],
  "scene_triggers": [
    {
      "key": "inverter_status_changed",
      "label": {
        "en": "Inverter state changed",
        "fr": "L'état de l'onduleur a changé",
        "de": "Wechselrichterzustand geändert",
        "es": "El estado del inversor ha cambiado"
      },
      "description": {
        "en": "The inverter goes to another state: fault, backup (EPS), standby, back to normal...",
        "fr": "L'onduleur passe dans un autre état : défaut, secours (EPS), veille, retour à la normale...",
        "de": "Der Wechselrichter wechselt den Zustand: Fehler, Notstrom (EPS), Standby, zurück zu normal...",
        "es": "El inversor pasa a otro estado: fallo, respaldo (EPS), reposo, vuelta a la normalidad..."
      },
