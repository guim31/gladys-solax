      "label": {
        "en": "Get the solar summary",
        "fr": "Obtenir le bilan solaire",
        "de": "Solarbilanz abrufen",
        "es": "Obtener el balance solar"
      },
      "description": {
        "en": "The last reading of an inverter, and a sentence ready to send in a message.",
        "fr": "La dernière mesure d'un onduleur, et une phrase prête à envoyer dans un message.",
        "de": "Die letzte Messung eines Wechselrichters und ein Satz, bereit für eine Nachricht.",
        "es": "La última medida de un inversor y una frase lista para enviar en un mensaje."
      },
      "timeout_seconds": 10,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Inverter",
            "fr": "Onduleur",
            "de": "Wechselrichter",
            "es": "Inversor"
          },
          "required": true
        }
      ],
      "outputs": [
