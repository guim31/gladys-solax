        },
        {
          "value": "x3_ultra",
          "label": {
            "en": "X3-Ultra",
            "fr": "X3-Ultra",
            "de": "X3-Ultra",
            "es": "X3-Ultra"
          }
        },
        {
          "value": "x1_lite_lv",
          "label": {
            "en": "X1-Lite LV",
            "fr": "X1-Lite LV",
            "de": "X1-Lite LV",
            "es": "X1-Lite LV"
          }
        }
      ]
    },
    {
      "key": "local_interval",
      "type": "select",
      "label": {
        "en": "Local refresh",
        "fr": "Rafraîchissement local",
        "de": "Lokale Aktualisierung",
        "es": "Actualización local"
      },
      "required": false,
      "default": "30",
      "options": [
        {
          "value": "10",
          "label": {
            "en": "Every 10 s",
            "fr": "Toutes les 10 s",
            "de": "Alle 10 s",
            "es": "Cada 10 s"
          }
        },
        {
          "value": "15",
          "label": {
            "en": "Every 15 s",
            "fr": "Toutes les 15 s",
            "de": "Alle 15 s",
            "es": "Cada 15 s"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "Every 30 s",
            "fr": "Toutes les 30 s",
            "de": "Alle 30 s",
            "es": "Cada 30 s"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "Every 60 s",
            "fr": "Toutes les 60 s",
            "de": "Alle 60 s",
            "es": "Cada 60 s"
          }
        }
      ]
    },
    {
      "key": "cloud",
      "type": "section",
      "label": {
        "en": "SolaX Cloud (optional)",
        "fr": "SolaX Cloud (facultatif)",
        "de": "SolaX Cloud (optional)",
        "es": "SolaX Cloud (opcional)"
      },
      "description": {
        "en": "Only for the dongles that do not answer locally. The API token is under Service, API on solaxcloud.com. SolaX allows 10 calls a minute and 10,000 a day, and the dongle uploads every 5 minutes: readings are 5 minutes apart at best.",
        "fr": "Seulement pour les clés qui ne répondent pas en local. Le jeton d'API est dans Service, API sur solaxcloud.com. SolaX autorise 10 appels par minute et 10 000 par jour, et la clé envoie ses données toutes les 5 minutes : une mesure toutes les 5 minutes au mieux.",
        "de": "Nur für Dongles, die lokal nicht antworten. Das API-Token findest du unter Service, API auf solaxcloud.com. SolaX erlaubt 10 Aufrufe pro Minute und 10.000 pro Tag, und der Dongle sendet alle 5 Minuten: höchstens eine Messung alle 5 Minuten.",
        "es": "Solo para los dongles que no responden en local. El token de la API está en Service, API de solaxcloud.com. SolaX permite 10 llamadas por minuto y 10 000 al día, y el dongle envía cada 5 minutos: como mucho una medida cada 5 minutos."
      }
    },
    {
      "key": "cloud_token",
      "type": "secret",
      "label": {
        "en": "SolaX Cloud API token",
        "fr": "Jeton d'API SolaX Cloud",
        "de": "SolaX-Cloud-API-Token",
        "es": "Token de la API de SolaX Cloud"
      },
      "required": false
    },
    {
      "key": "cloud_serials",
      "type": "string",
      "label": {
        "en": "Registration numbers",
        "fr": "Numéros d'enregistrement",
        "de": "Registriernummern",
        "es": "Números de registro"
      },
      "description": {
        "en": "The registration number of each dongle to read through SolaX Cloud, separated by commas.",
        "fr": "Le numéro d'enregistrement de chaque clé à lire par SolaX Cloud, séparés par des virgules.",
        "de": "Die Registriernummer jedes über SolaX Cloud zu lesenden Dongles, durch Kommas getrennt.",
        "es": "El número de registro de cada dongle que se leerá mediante SolaX Cloud, separados por comas."
      },
      "placeholder": {
        "en": "e.g. SABCDE1234",
        "fr": "ex. SABCDE1234",
        "de": "z. B. SABCDE1234",
        "es": "p. ej. SABCDE1234"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "cloud_interval",
      "type": "select",
      "label": {
