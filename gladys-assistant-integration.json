        "fr": "Rafraîchissement cloud",
        "de": "Cloud-Aktualisierung",
        "es": "Actualización en la nube"
      },
      "required": false,
      "default": "5",
      "options": [
        {
          "value": "5",
          "label": {
            "en": "Every 5 min",
            "fr": "Toutes les 5 min",
            "de": "Alle 5 min",
            "es": "Cada 5 min"
          }
        },
        {
